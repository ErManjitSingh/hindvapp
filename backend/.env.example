PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/travel_crm

JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=30d

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173
COMPANY_PHONE=+91 70188 55020

SEED_PASSWORD=123456

# Optional — shared cache (falls back to in-memory if unavailable)
REDIS_URL=redis://127.0.0.1:6379

# Web Push (multi-device notifications) — generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@hindholidays.com

# Optional email (off until EMAIL_ENABLED=true and SMTP is set)
# EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=info@hindholidays.com
SMTP_PASS=
SMTP_FROM_NAME=HindHolidays

# Optional IMAP reply tracking
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=
# EMAIL_INBOX_POLL_MS=300000

# Optional Meta / WhatsApp / landing ingest (off until credentials are provided)
# FACEBOOK_ENABLED=true
# FACEBOOK_VERIFY_TOKEN=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_APP_SECRET=
# WHATSAPP_ENABLED=true
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# PUBLIC_LEAD_INGEST_ENABLED=true
# PUBLIC_LEAD_API_KEY=

# Hotel package catalog is imported into Mongo (npm run import:uno-packages).
# Live UNO proxy is only used as fallback until the catalog has been saved.
# UNO_HOTELS_API_BASE_URL=
# UNO_HOTELS_ADMIN_TOKEN=
# UNO_HOTELS_ADMIN_EMAIL=
# UNO_HOTELS_ADMIN_PASSWORD=
# UNO_HOTELS_OPS_USERNAME=
# UNO_HOTELS_OPS_PASSWORD=
# UNO_HOTELS_RATE_OVERRIDE_CHANNEL=staff
